{
  "identity": {
    "id": "l2-reimbursement-check-v1",
    "name": "报销单合规检查",
    "version": "1.0.0",
    "author": "official",
    "createdAt": 1700000000000,
    "updatedAt": 1700000000000,
    "templateId": "official-reimbursement-check"
  },
  "visual": {
    "baseColor": "#00e5ff",
    "ringStyle": "solid",
    "badges": ["chain", "sparkle"],
    "hoverLabel": "上传报销单→合规检查报告",
    "anchorGlow": "#00ffcc",
    "upgradeGlow": "#ffd700"
  },
  "routing": {
    "keywords": ["报销", "合规", "报销单", "费用", "审批", "财务合规"],
    "targetRoles": ["finance"],
    "requiredL1": ["l1-knowledge-feeder", "l1-task-translator", "l1-result-beautifier"],
    "inputType": "file",
    "retrievalSummary": "上传报销单文件，自动检查合规性并生成检查报告"
  },
  "execution": {
    "mode": "macro",
    "dagPlan": {
      "steps": [
        {
          "step": 1,
          "description": "检索报销合规政策",
          "tool": "knowledge_search",
          "depends_on": [],
          "params": { "query": "报销合规政策 费用标准 审批流程 报销限额" },
          "expectedOutput": "报销合规政策要点",
          "fallback": "llm_generate"
        },
        {
          "step": 2,
          "description": "读取报销单文件",
          "tool": "read_file",
          "depends_on": [],
          "params": { "path": "{{user_file}}" },
          "expectedOutput": "报销单内容"
        },
        {
          "step": 3,
          "description": "AI分析报销单合规性",
          "tool": "llm_generate",
          "depends_on": [1, 2],
          "params": {
            "prompt": "你是财务合规审查专家。根据报销合规政策和报销单内容，逐项检查合规性。标注：合规/不合规、不合规原因、修改建议。\n\n合规政策：{{step_1_result}}\n\n报销单内容：{{step_2_result}}"
          },
          "expectedOutput": "合规检查结果",
          "fallback": "llm_generate"
        },
        {
          "step": 4,
          "description": "生成合规检查报告",
          "tool": "shell_exec",
          "depends_on": [3],
          "params": {
            "command": "node -e \"const {Document,Packer,Paragraph,TextRun,HeadingLevel}=require('docx');const fs=require('fs');const analysis=process.env.ANALYSIS;const doc=new Document({sections:[{children:[new Paragraph({text:'报销单合规检查报告',heading:HeadingLevel.HEADING_1}),new Paragraph({children:[new TextRun(analysis)]})]}]});Packer.toBuffer(doc).then(buf=>fs.writeFileSync(process.env.USERPROFILE+'\\\\Desktop\\\\报销单合规检查报告.docx',buf))\""
          },
          "expectedOutput": "桌面docx报告"
        }
      ],
      "fallbackStrategy": "retry",
      "maxRetries": 2
    },
    "paramMapping": {
      "slots": [
        {
          "name": "{{user_file}}",
          "source": "file_path",
          "description": "报销单文件路径",
          "required": true
        }
      ],
      "bindings": [
        {
          "slotName": "{{user_file}}",
          "targetStep": 2,
          "targetParam": "path"
        }
      ]
    }
  },
  "cacheMeta": {
    "estimatedTokenSaving": 2200,
    "avgExecutionTime": 12000,
    "cacheable": false,
    "cacheTTL": 0
  }
}
